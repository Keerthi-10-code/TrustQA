# Copy to .env and fill in. Never commit .env.

# LLM provider: ollama (local, free, default) | groq (free key) | anthropic (paid, optional)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434
# For Groq: LLM_PROVIDER=groq, LLM_MODEL=llama-3.3-70b-versatile, key from console.groq.com
GROQ_API_KEY=
ANTHROPIC_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=300

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TESSERACT_CMD=
# OCR fallback (Phase 2): a page is OCR'd when its text layer has < OCR_MIN_CHARS
# alphanumeric chars or > OCR_MAX_NONALNUM_RATIO non-alphanumeric/undecodable chars.
OCR_ENABLED=1
OCR_MIN_CHARS=50
OCR_MAX_NONALNUM_RATIO=0.6
OCR_DPI=300
OCR_LANG=eng
OCR_PSM=3
# grayscale + deskew + Otsu before Tesseract (slightly worse on the pilot scan; off)
OCR_PREPROCESS=0
# Tables and verification. BASELINE_B=1 reproduces baseline system B
# (OCR + plain RAG): forces FLATTEN_TABLES=1 and VERIFY=0.
FLATTEN_TABLES=0
VERIFY=1
BASELINE_B=0
# Verification (Phase 3). VERIFY_* switches are for ablations; with one off, answers
# cannot be Verified. ABSTAIN_MIN_SCORE is calibrated for MiniLM cosine scores.
VERIFY_SUPPORT=1
VERIFY_NUMERIC=1
VERIFY_CONFLICTS=1
ABSTAIN_MIN_SCORE=0.30
OCR_WARN_CONFIDENCE=90
QUOTE_MIN_SIMILARITY=90
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
