# Copy to .env and fill in. Never commit .env.

# LLM provider: ollama (local, free, default) | groq (free key) | anthropic (paid, optional)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434
# For Groq: LLM_PROVIDER=groq, LLM_MODEL=llama-3.3-70b-versatile, key from console.groq.com
GROQ_API_KEY=
ANTHROPIC_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=300

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TESSERACT_CMD=
# OCR fallback (Phase 2): a page is OCR'd when its text layer has < OCR_MIN_CHARS
# alphanumeric chars or > OCR_MAX_NONALNUM_RATIO non-alphanumeric/undecodable chars.
OCR_ENABLED=1
OCR_MIN_CHARS=50
OCR_MAX_NONALNUM_RATIO=0.6
OCR_DPI=300
OCR_LANG=eng
OCR_PSM=3
# grayscale + deskew + Otsu before Tesseract (slightly worse on the pilot scan; off)
OCR_PREPROCESS=0
# Tables and verification. BASELINE_B=1 reproduces baseline system B
# (OCR + plain RAG): forces FLATTEN_TABLES=1 and VERIFY=0.
FLATTEN_TABLES=0
VERIFY=1
BASELINE_B=0
# Verification (Phase 3). VERIFY_* switches are for ablations; with one off, answers
# cannot be Verified. ABSTAIN_MIN_SCORE is calibrated for MiniLM cosine scores.
VERIFY_SUPPORT=1
VERIFY_NUMERIC=1
VERIFY_CONFLICTS=1
ABSTAIN_MIN_SCORE=0.15      # only a floor: scores do not separate answerable from unanswerable
OCR_WARN_CONFIDENCE=90
QUOTE_MIN_SIMILARITY=90
TOP_K=5
# Retrieval upgrades (Phase 4); results in eval/results/retrieval_phase4.md. Config defaults are
# all off; hybrid is the chosen setting for system C. They only reorder chunks (scores stay dense
# cosine). Baselines A/B (tables flattened, VERIFY=0) always run with them off.
RETRIEVAL_HYBRID=1          # BM25 + dense via reciprocal rank fusion (fixes F3/F4 retrieval)
RRF_K=60
RETRIEVAL_CANDIDATES=50
RETRIEVAL_DIVERSIFY=none    # none | quota | mmr (both measured worse or no gain)
DOC_QUOTA=2
MMR_LAMBDA=0.7
RERANK=0                    # cross-encoder; +1.2-1.7 s/query on CPU, no Recall@5 gain
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_DECOMPOSE=0       # LLM sub-queries per entity; no gain with qwen2.5:3b, +2.9 s/query
MAX_SUBQUERIES=3
RETRIEVAL_ENTITY_SCOPE=1    # each paper the question names gets a share of the top-k (F12)
# Phase 6 fixes for system C (phases.md Phase 6 notes); baselines A/B force the retrieval and
# prompt switches off.
SECTION_HEADINGS=1          # chunks know their section heading (lists split over chunks)
GATE_LEXICAL_PASS=1         # a passage containing every question word passes the gate (typo-tolerant)
VERIFY_SCOPE=1              # answers citing a paper the question is not about are withheld (F13)
VERIFY_ANSWERS_QUESTION=1   # quantity questions need a number to be Verified (F10)
SUPPORT_NUMBER_FALLBACK=1   # correct short numbers are not lost to a bad judge quote (F14)
CITATION_REPAIR=1           # a number cited from the neighbouring chunk on the same page is checked there
SUPPORT_RETRY_MISSING=1     # ask the judge again for claims it skipped (long answers)
GENERATION_PROMPT=grounded-v2   # answer directly, list every item (baselines keep grounded-v1)
JUDGE_ANSWERS_QUESTION=0    # harmful with qwen2.5:3b (flags correct answers); try with a stronger judge
CHUNK_SIZE=800
CHUNK_OVERLAP=150
