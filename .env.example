# Copy to .env and fill in. Never commit .env.

# LLM provider: ollama (local, free, default) | groq (free key) | anthropic (paid, optional)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434
# For Groq: LLM_PROVIDER=groq, LLM_MODEL=llama-3.3-70b-versatile, key from console.groq.com
GROQ_API_KEY=
ANTHROPIC_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=300

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TESSERACT_CMD=
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
